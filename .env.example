# Copy this file to  .env.local  (same folder) and fill it in. NEVER commit .env.local.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# --- Firebase Admin (server only). Firebase console -> Project settings -> Service accounts
#     -> "Generate new private key". Copy two values from the downloaded JSON file:
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE-THE-WHOLE-KEY-HERE\n-----END PRIVATE KEY-----\n"

# --- Groq (optional battle commentary). Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Optional: the web-app values already default to your project; only set to override.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
